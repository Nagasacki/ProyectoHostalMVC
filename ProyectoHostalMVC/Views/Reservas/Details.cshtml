@model ProyectoHostalMVC.Models.ReservaDetalleViewModel
@{
    var r = Model.Reserva;
    ViewData["Title"] = "Reserva #" + r.IdReserva;
}

<div class="page-heading d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><h1>Reserva #@r.IdReserva.ToString("D5")</h1><p>@r.NombreCliente · Habitación @r.NumeroHabitacion</p></div>
    <span class="status status-@r.Estado.ToLower().Replace(" ", "-")">@r.Estado</span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <section class="card mb-4">
            <div class="card-header"><h2>Datos de la estadía</h2></div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-sm-6 col-md-3"><small class="text-muted d-block">Entrada prevista</small><strong>@r.FechaEntrada.ToString("dd/MM/yyyy")</strong></div>
                    <div class="col-sm-6 col-md-3"><small class="text-muted d-block">Salida prevista</small><strong>@r.FechaSalida.ToString("dd/MM/yyyy")</strong></div>
                    <div class="col-sm-6 col-md-3"><small class="text-muted d-block">Check-in real</small><strong>@(r.FechaCheckInReal?.ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")</strong></div>
                    <div class="col-sm-6 col-md-3"><small class="text-muted d-block">Check-out real</small><strong>@(r.FechaCheckOutReal?.ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")</strong></div>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-header d-flex justify-content-between align-items-center"><h2>Historial de pagos</h2>@if (r.Estado is "Confirmada" or "Hospedado" && r.Saldo > 0) { <a asp-controller="Pagos" asp-action="Create" asp-route-idReserva="@r.IdReserva" class="btn btn-sm btn-primary">Registrar pago</a> }</div>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Fecha</th><th>Tipo</th><th>Método</th><th>Operación</th><th class="text-end">Monto</th></tr></thead>
                    <tbody>
                        @if (Model.Pagos.Any())
                        {
                            foreach (var p in Model.Pagos)
                            {
                                <tr><td>@p.FechaPago.ToString("dd/MM/yyyy HH:mm")</td><td>@p.Tipo</td><td>@p.Metodo</td><td>@(p.NumeroOperacion ?? "—")</td><td class="text-end fw-semibold">S/ @p.Monto.ToString("0.00")</td></tr>
                            }
                        }
                        else { <tr><td colspan="5" class="empty-row">Todavía no se registraron pagos.</td></tr> }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="col-lg-4">
        <aside class="card p-4 mb-4">
            <h2 class="h6 fw-bold mb-3">Resumen de cuenta</h2>
            <div class="d-flex justify-content-between py-2 border-bottom"><span>Tarifa</span><span>S/ @r.PrecioDia.ToString("0.00") × @r.CantidadDias</span></div>
            <div class="d-flex justify-content-between py-2 border-bottom"><span>Total</span><strong>S/ @r.Total.ToString("0.00")</strong></div>
            <div class="d-flex justify-content-between py-2 border-bottom text-success"><span>Pagado</span><strong>S/ @r.MontoPagado.ToString("0.00")</strong></div>
            <div class="d-flex justify-content-between pt-3 fs-5"><span>Saldo</span><strong class="@(r.Saldo > 0 ? "text-danger" : "text-success")">S/ @r.Saldo.ToString("0.00")</strong></div>
        </aside>

        <aside class="card p-4">
            <h2 class="h6 fw-bold mb-3">Acciones</h2>
            <div class="d-grid gap-2">
                @if (r.Estado == "Confirmada")
                {
                    <form asp-action="CheckIn" asp-route-id="@r.IdReserva" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary w-100">Realizar check-in</button></form>
                    <form asp-action="NoPresentado" asp-route-id="@r.IdReserva" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary w-100">Marcar no presentado</button></form>
                    <form asp-action="Cancelar" asp-route-id="@r.IdReserva" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-danger w-100">Cancelar reserva</button></form>
                }
                else if (r.Estado == "Hospedado")
                {
                    @if (r.Saldo == 0)
                    {
                        <form asp-action="CheckOut" asp-route-id="@r.IdReserva" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary w-100">Realizar check-out</button></form>
                    }
                    else
                    {
                        <a asp-controller="Pagos" asp-action="Create" asp-route-idReserva="@r.IdReserva" class="btn btn-primary">Pagar saldo para check-out</a>
                        <small class="text-muted text-center">El check-out se habilita al completar el pago.</small>
                    }
                }
                <button type="button" onclick="window.print()" class="btn btn-outline-secondary">Imprimir comprobante</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Volver a reservas</a>
            </div>
        </aside>
    </div>
</div>
