@model ProyectoHostalMVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión - Hostal Velamor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-shell">
        <div class="login-photo" role="img" aria-label="Recepción del Hostal Velamor"></div>
        <div class="login-form-area">
            <div class="login-form">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <img src="~/images/logo-velamor.png" class="login-logo" alt="Logo" />
                    <div><strong>HOSTAL VELAMOR</strong><small>Sistema de gestión hotelera</small></div>
                </div>
                <h1>Bienvenido</h1>
                <p class="text-muted mb-4">Ingresa para revisar la operación del hotel.</p>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label"></label>
                        <input asp-for="Correo" class="form-control" placeholder="correo@hostalvelamor.com" autofocus />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Clave" class="form-label"></label>
                        <input asp-for="Clave" class="form-control" placeholder="Contraseña" />
                        <span asp-validation-for="Clave" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label small"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2">Iniciar sesión</button>
                </form>

                <div class="demo-users mt-4">
                    <strong>Cuentas de demostración</strong>
                    <span>admin@hostalvelamor.com · Admin123*</span>
                    <span>recepcion@hostalvelamor.com · Recepcion123*</span>
                </div>
            </div>
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
</body>
</html>
