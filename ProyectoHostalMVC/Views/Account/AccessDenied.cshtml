@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container text-center py-5">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 550px;">
        <div class="card-body p-5">
            <i class="bi bi-shield-x text-danger display-1 mb-3 d-inline-block"></i>
            <h2 class="fw-bold text-danger mb-2">Acceso Denegado</h2>
            <p class="text-muted mb-4">No cuenta con los permisos suficientes (Rol Administrador) para acceder a este módulo.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-house-door-fill me-1"></i> Volver al Inicio
            </a>
        </div>
    </div>
</div>