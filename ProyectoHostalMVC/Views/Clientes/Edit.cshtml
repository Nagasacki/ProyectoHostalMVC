@model ProyectoHostalMVC.Models.Cliente
@{ ViewData["Title"] = "Editar huésped"; }
<div class="page-heading mb-4"><h1>Editar huésped</h1><p>Actualiza sus datos personales y de contacto.</p></div>
<div class="card p-4 mx-auto" style="max-width:850px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="IdCliente" type="hidden" />
        <partial name="_Formulario" model="Model" />
        <div class="d-flex justify-content-end gap-2 pt-4 mt-4 border-top"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary">Actualizar huésped</button></div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
