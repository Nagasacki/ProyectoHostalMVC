@model ProyectoHostalMVC.Models.Cliente

@{
    ViewData["Title"] = "Detalle del Cliente";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h4 class="mb-0">
                Detalle del Cliente
            </h4>
        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>ID:</strong>
                </div>

                <div class="col-md-8">
                    @Model.IdCliente
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>DNI:</strong>
                </div>

                <div class="col-md-8">
                    @Model.Dni
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Nombre:</strong>
                </div>

                <div class="col-md-8">
                    @Model.Nombre
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Teléfono:</strong>
                </div>

                <div class="col-md-8">
                    @Model.Telefono
                </div>

            </div>


            <div class="row mb-4">

                <div class="col-md-4">
                    <strong>Correo:</strong>
                </div>

                <div class="col-md-8">
                    @Model.Correo
                </div>

            </div>


            <a asp-action="Edit"
               asp-route-id="@Model.IdCliente"
               class="btn btn-warning">

                Editar

            </a>


            <a asp-action="Index"
               class="btn btn-secondary">

                Regresar

            </a>

        </div>

    </div>

</div>