@model ProyectoHostalMVC.Models.Cliente
@{ ViewData["Title"] = "Ficha del huésped"; }
<div class="page-heading d-flex justify-content-between align-items-center mb-4"><div><h1>Ficha del huésped</h1><p>Información registrada para su estadía.</p></div><a asp-action="Edit" asp-route-id="@Model.IdCliente" class="btn btn-outline-secondary">Editar</a></div>
<div class="card p-4 mx-auto" style="max-width:850px;">
    <h2 class="h4 fw-bold mb-1">@Model.Nombre</h2><p class="text-muted mb-4">@Model.TipoDocumento @Model.Dni · @(Model.Nacionalidad ?? "Nacionalidad no registrada")</p>
    <div class="row g-4">
        <div class="col-md-4"><small class="text-muted d-block">Teléfono</small><strong>@Model.Telefono</strong></div>
        <div class="col-md-4"><small class="text-muted d-block">Correo</small><strong>@Model.Correo</strong></div>
        <div class="col-md-4"><small class="text-muted d-block">Nacimiento</small><strong>@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No registrado")</strong></div>
        <div class="col-md-8"><small class="text-muted d-block">Dirección</small><strong>@(Model.Direccion ?? "No registrada")</strong></div>
        <div class="col-md-4"><small class="text-muted d-block">Contacto de emergencia</small><strong>@(Model.ContactoEmergencia ?? "No registrado")</strong></div>
        <div class="col-12"><small class="text-muted d-block">Observaciones</small><span>@(Model.Observaciones ?? "Sin observaciones")</span></div>
    </div>
    <div class="border-top pt-3 mt-4"><a asp-action="Index" class="btn btn-outline-secondary">Volver</a></div>
</div>
