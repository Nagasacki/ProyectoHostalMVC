@model ProyectoHostalMVC.Models.Cliente
@{ ViewData["Title"] = "Nuevo huésped"; }
<div class="page-heading mb-4"><h1>Nuevo huésped</h1><p>Datos básicos para reservas y contacto.</p></div>
<div class="card p-4 mx-auto" style="max-width:850px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <partial name="_Formulario" model="Model" />
        <div class="d-flex justify-content-end gap-2 pt-4 mt-4 border-top"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary">Guardar huésped</button></div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
