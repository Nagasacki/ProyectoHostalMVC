@model ProyectoHostalMVC.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="container py-2" style="max-width: 500px;">
    <div class="card p-4 border-danger">
        <h5 class="fw-bold text-danger mb-2">Confirmar Eliminación</h5>
        <p class="text-secondary small mb-3">¿Está seguro de que desea eliminar a este cliente? Esta acción no se puede deshacer.</p>

        <div class="p-3 bg-light rounded mb-3 small">
            <div><strong>Nombre:</strong> @Model.Nombre</div>
            <div><strong>DNI:</strong> @Model.Dni</div>
            <div><strong>Correo:</strong> @Model.Correo</div>
        </div>

        <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2 pt-2 border-top">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdCliente" />
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-danger">Eliminar</button>
        </form>
    </div>
</div>