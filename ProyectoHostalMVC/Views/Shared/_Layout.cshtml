<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hostal Velamor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-light bg-white py-2">
            <div class="container-fluid app-container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-velamor.png" class="brand-logo" alt="Logo Hostal Velamor" />
                    <span>HOSTAL VELAMOR</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav mx-auto gap-lg-2">
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Habitaciones" asp-action="Index"><i class="bi bi-door-open"></i> Habitaciones</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Clientes" asp-action="Index"><i class="bi bi-people"></i> Huéspedes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reservas" asp-action="Index"><i class="bi bi-calendar-check"></i> Reservas</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Pagos" asp-action="Index"><i class="bi bi-credit-card"></i> Pagos</a></li>
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="Index"><i class="bi bi-bar-chart"></i> Reportes</a></li>
                            }
                        </ul>

                        <div class="dropdown user-menu">
                            <button class="btn btn-light btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                <span class="user-avatar">@(User.Identity.Name?.Substring(0, 1).ToUpper())</span>
                                <span class="d-none d-xl-inline">@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text small text-muted">@(User.IsInRole("Administrador") ? "Administrador" : "Recepción")</span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="dropdown-item text-danger" type="submit">Cerrar sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="app-container container-fluid py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top py-3 mt-auto">
        <div class="app-container container-fluid d-flex justify-content-between small text-muted">
            <span>Hostal Velamor · Gestión hotelera</span>
            <span>2026</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (TempData["SweetAlert_Title"] != null)
    {
        <script>
            Swal.fire({
                title: '@TempData["SweetAlert_Title"]',
                text: '@TempData["SweetAlert_Text"]',
                icon: '@(TempData["SweetAlert_Type"] ?? "info")',
                confirmButtonColor: '#123b3a',
                confirmButtonText: 'Aceptar'
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
