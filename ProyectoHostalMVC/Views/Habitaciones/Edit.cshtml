@model ProyectoHostalMVC.Models.Habitacion

@{
    ViewData["Title"] = "Editar Habitación";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">
            <h4>Editar Habitación</h4>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <!-- ID oculto -->
                <input asp-for="IdHabitacion"
                       type="hidden" />


                <div class="mb-3">

                    <label asp-for="Numero"
                           class="form-label">
                        Número de Habitación
                    </label>

                    <input asp-for="Numero"
                           class="form-control" />

                </div>


                <div class="mb-3">

                    <label asp-for="Tipo"
                           class="form-label">
                        Tipo
                    </label>

                    <select asp-for="Tipo"
                            class="form-select">

                        <option value="Simple">
                            Simple
                        </option>

                        <option value="Matrimonial">
                            Matrimonial
                        </option>

                        <option value="Premium">
                            Premium
                        </option>

                    </select>

                </div>


                <div class="mb-3">

                    <label asp-for="Precio"
                           class="form-label">
                        Precio
                    </label>

                    <input asp-for="Precio"
                           class="form-control"
                           type="number"
                           step="0.01" />

                </div>


                <div class="mb-3">

                    <label asp-for="Estado"
                           class="form-label">
                        Estado
                    </label>

                    <select asp-for="Estado"
                            class="form-select">

                        <option value="Disponible">
                            Disponible
                        </option>

                        <option value="Ocupada">
                            Ocupada
                        </option>

                        <option value="Mantenimiento">
                            Mantenimiento
                        </option>

                    </select>

                </div>


                <button type="submit"
                        class="btn btn-warning">

                    Actualizar

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>

            </form>

        </div>

    </div>

</div>