@model ProyectoHostalMVC.Models.Habitacion

@{
    ViewData["Title"] = "Eliminar Habitación";
}

<div class="container py-2" style="max-width: 500px;">
    <div class="card p-4 border-danger">
        <h5 class="fw-bold text-danger mb-2">Eliminar Habitación</h5>
        <p class="text-secondary small mb-3">¿Confirma que desea eliminar la habitación <strong>@Model.Numero</strong>?</p>

        <div class="p-3 bg-light rounded mb-3 small">
            <div><strong>Número:</strong> @Model.Numero</div>
            <div><strong>Tipo:</strong> @Model.Tipo</div>
            <div><strong>Precio:</strong> S/ @Model.Precio.ToString("0.00")</div>
        </div>

        <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2 pt-2 border-top">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdHabitacion" />
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-danger">Eliminar</button>
        </form>
    </div>
</div>