@model ProyectoHostalMVC.Models.Habitacion

@{
    ViewData["Title"] = "Eliminar Habitación";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">
                Eliminar Habitación
            </h4>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">

                ¿Está seguro que desea eliminar esta habitación?

            </div>


            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>ID:</strong>
                </div>

                <div class="col-md-8">
                    @Model.IdHabitacion
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Número:</strong>
                </div>

                <div class="col-md-8">
                    @Model.Numero
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Tipo:</strong>
                </div>

                <div class="col-md-8">
                    @Model.Tipo
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Precio:</strong>
                </div>

                <div class="col-md-8">
                    S/ @Model.Precio.ToString("0.00")
                </div>

            </div>


            <div class="row mb-4">

                <div class="col-md-4">
                    <strong>Estado:</strong>
                </div>

                <div class="col-md-8">
                    @Model.Estado
                </div>

            </div>


            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.IdHabitacion" />


                <button type="submit"
                        class="btn btn-danger">

                    Eliminar

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>

            </form>

        </div>

    </div>

</div>