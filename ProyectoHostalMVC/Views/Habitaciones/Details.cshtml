@model ProyectoHostalMVC.Models.Habitacion

@{
    ViewData["Title"] = "Detalle de Habitación";
}

<div class="container py-2" style="max-width: 500px;">
    <div class="card p-4">
        <h5 class="fw-bold text-dark mb-3">Habitación @Model.Numero</h5>
        
        <div class="row g-3 mb-4">
            <div class="col-6">
                <span class="text-muted small d-block">Tipo</span>
                <div class="fw-medium text-dark">@Model.Tipo</div>
            </div>
            <div class="col-6">
                <span class="text-muted small d-block">Tarifa</span>
                <div class="fw-semibold text-dark">S/ @Model.Precio.ToString("0.00")</div>
            </div>
            <div class="col-12">
                <span class="text-muted small d-block">Estado</span>
                <div>
                    @if (Model.Estado == "Disponible")
                    {
                        <span class="badge-subtle-success">Disponible</span>
                    }
                    else if (Model.Estado == "Ocupada")
                    {
                        <span class="badge-subtle-danger">Ocupada</span>
                    }
                    else
                    {
                        <span class="badge-subtle-neutral">@Model.Estado</span>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Edit" asp-route-id="@Model.IdHabitacion" class="btn btn-outline-dark">Editar</a>
            }
        </div>
    </div>
</div>