@model ProyectoHostalMVC.Models.PaginacionRespuesta<ProyectoHostalMVC.Models.Habitacion>

@{
    ViewData["Title"] = "Habitaciones";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
        <h4 class="fw-bold text-dark mb-0">Habitaciones</h4>
        <span class="text-muted small">Catálogo de habitaciones y estados de ocupación</span>
    </div>
    @if (User.IsInRole("Administrador"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">
            + Nueva Habitación
        </a>
    }
</div>

<!-- BUSCADOR -->
<div class="card p-3 mb-3">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-9 col-lg-10">
            <input type="text" name="busqueda" value="@Model.TerminoBusqueda" class="form-control form-control-sm" placeholder="Buscar por número (ej. 101), tipo o estado..." />
        </div>
        <div class="col-md-3 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-dark btn-sm w-100">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(Model.TerminoBusqueda))
            {
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar</a>
            }
        </div>
    </form>
</div>

<!-- TABLA -->
<div class="card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th class="ps-3">Número</th>
                    <th>Tipo</th>
                    <th>Tarifa / Noche</th>
                    <th>Estado</th>
                    <th class="text-end pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-3 fw-bold font-monospace text-dark">Hab. @item.Numero</td>
                            <td class="text-secondary">@item.Tipo</td>
                            <td class="fw-medium text-dark">S/ @item.Precio.ToString("0.00")</td>
                            <td>
                                @if (item.Estado == "Disponible")
                                {
                                    <span class="badge-subtle-success">Disponible</span>
                                }
                                else if (item.Estado == "Ocupada")
                                {
                                    <span class="badge-subtle-danger">Ocupada</span>
                                }
                                else
                                {
                                    <span class="badge-subtle-neutral">@item.Estado</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                @if (item.Estado == "Limpieza")
                                {
                                    <form asp-action="MarcarDisponible" asp-route-id="@item.IdHabitacion" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-primary btn-sm py-0 px-2" type="submit">Limpieza lista</button>
                                    </form>
                                }
                                <a asp-action="Details" asp-route-id="@item.IdHabitacion" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Detalle">Ver</a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.IdHabitacion" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Editar">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.IdHabitacion" class="btn btn-outline-secondary text-danger btn-sm py-0 px-2" title="Eliminar">Eliminar</a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted small">
                            No se encontraron habitaciones registradas.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINACIÓN -->
    @if (Model.TotalPaginas > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center py-2 px-3">
            <small class="text-muted">
                Página @Model.PaginaActual de @Model.TotalPaginas (@Model.TotalRegistros registros)
            </small>
            <nav aria-label="Navegacion">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual - 1)" asp-route-busqueda="@Model.TerminoBusqueda">&laquo;</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@Model.TerminoBusqueda">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual + 1)" asp-route-busqueda="@Model.TerminoBusqueda">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
